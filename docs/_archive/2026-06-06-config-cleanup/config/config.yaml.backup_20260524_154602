# ============================================================
# NAS影视自动化入库系统 - 配置文件
# ============================================================
# 修改后需重启服务才能生效
# 配置模板参考: config.yaml.example

# ------------------------------------------------------------
# 1. 轮询监控配置
# ------------------------------------------------------------
file_watcher:
  enabled: true                 # 是否启用文件监控（轮询扫描源目录）
  poll_interval: 60               # 轮询间隔（秒），建议不低于30秒
  ignore_patterns:                # 监控忽略的文件名模式
  - '*.tmp'
  - .DS_Store
  - '*partial*'
server:
  host: "0.0.0.0"                 # API监听地址，0.0.0.0 监听所有网卡
  port: 9855                      # API监听端口
                                  # ⚠️ 修改端口后需: 1.重启服务 2.同步修改Hermes路由配置
                                  #   3.防火墙放行新端口 4.浏览器地址同步修改
  api_key: "oppenssl-11"          # API认证密钥，为空则不启用认证
                                  # 设置后所有 /api/ 端点需携带 Authorization: Bearer <api_key>
                                  # 建议使用随机字符串，如: openssl rand -hex 32

# [必须] 影视文件来源目录
source_dir: "/tmp/nas_media_test/source"
# [必须] 处理过程中的中转目录
temp_dir: "/tmp/nas_media_test/temp"
# [必须] 日志目录
log_dir: "/tmp/nas_media_test/logs"

source_dir_scan:
  recursive: true               # 是否递归扫描子目录
  max_depth: 5                    # 递归最大深度
  ignore_patterns:                # 扫描忽略的文件名模式
  - '*.tmp'
  - .DS_Store
  - '*partial*'

video_extensions:                 # 支持的视频格式（仅这些后缀的文件会被处理）
- .mkv
- .mp4
- .avi
- .ts
- .mov
- .wmv
- .m2ts
- .flv
subtitle_extensions:              # 支持的字幕格式
- .srt
- .ass
- .ssa
- .vtt
- .sub
dimensions:
- name: media_type
  label: 影视类型
  values:
  - movie
  - tv
  ai_prompt: 请判断这是电影还是电视剧（movie/tv）
- name: documentary
  label: 是否纪录片
  values:
  - true
  - false
  ai_prompt: 请判断是否为纪录片（true/false）
- name: animation
  label: 是否动漫
  values:
  - true
  - false
  ai_prompt: 请判断是否为动漫/动画作品（true/false），包括日漫、国漫、欧美动画电影等
- name: restricted_level
  label: 限制级分类
  values:
  - 0-6
  - 7-12
  - 13-15
  - 17+
  ai_prompt: 请判断内容的年龄分级：0-6（幼儿/儿童）、7-12（家庭向）、13-15（青少年）、17+（成人）
path_rules:
- conditions:
    media_type: tv
    restricted_level: 17+
  template: '/tmp/nas_media_test/影视/tv-R/{title_cn} ({year})/'
- conditions:
    media_type: movie
    restricted_level: 17+
  template: /tmp/nas_media_test/影视/movies-R/
- conditions:
    animation: 'true'
    restricted_level: '0-6|7-12|13-15|17+'
  template: /tmp/nas_media_test/影视/动漫/
- conditions:
    media_type: tv
    documentary: 'true'
    restricted_level: '0-6|7-12|13-15'
  template: '/tmp/nas_media_test/影视/纪录片/TV/{title_cn} ({year})/Season {season}/'
- conditions:
    media_type: tv
    documentary: 'false'
    restricted_level: '0-6|7-12|13-15'
  template: '/tmp/nas_media_test/影视/电视剧/{title_cn} ({year})/Season {season}/'
- conditions:
    media_type: movie
    documentary: 'true'
    restricted_level: '0-6|7-12|13-15'
  template: /tmp/nas_media_test/影视/纪录片/movies/
- conditions:
    media_type: movie
    documentary: 'false'
    restricted_level: '0-6|7-12|13-15'
  template: /tmp/nas_media_test/影视/movies/
rules:
- name: tv_series_folder
  description: 电视剧必须单独文件夹
  conditions:
    media_type: tv
  actions:
  - create_series_folder: true
  - organize_by_season: true
  - use_series_subfolder: '{title_cn} ({year})/'
- name: movie_year_folder
  description: 电影按年份分文件夹
  conditions:
    media_type: movie
  actions:
  - create_year_folder: true
filename_templates:
  movie: '{title_cn}.{title_en}.{year}.{resolution}.{quality}.{ext}'
  tv: '{title_cn}.{title_en}.{year}.S{season:02d}E{episode:02d}.{resolution}.{quality}.{ext}'
  subtitle: '{video_filename}.{lang}.{ext}'

# ------------------------------------------------------------
# 5. 同名文件处理配置
# ------------------------------------------------------------
duplicate_handling:
  enabled: true                    # 是否启用智能同名检测
                                   #   true  - 扫描所有入库目录，按下方 strategy 处理
                                   #   false - 跳过智能检测，仅在文件移动到目标目录时检测同名
  strategy: "quality"              # 处理策略（仅 enabled=true 时生效）:
                                   #   skip(跳过) - 同名文件已存在则跳过
                                   #   replace(替换) - 用新文件替换已存在的文件
                                   #   rename(重命名) - 两者都保留，新文件添加编号后缀
                                   #   quality(质量优先) - 保留高质量版本：
                                   #     - 有分辨率时按高分辨率优先
                                   #     - 相同分辨率时保留较小文件（压缩更好）
                                   #     - 无分辨率信息时保留体积较大的文件

# ------------------------------------------------------------
# 6. 源文件处理配置
# ------------------------------------------------------------
source_file_handling:
  delete_after_process: true    # 处理成功或跳过后是否删除源文件
                                  # 启用后，视频、字幕及同名附属文件（如 .nfo、.jpg 等）将被一并删除
                                  # 目录中无视频/字幕的孤立文件也会被清理，空目录递归删除
                                  # ⚠️ 若关闭此选项，源文件将保留在源目录中，
                                  #   每次轮询都会重新扫描并尝试处理之前失败的文件，持续消耗 AI Token

# ------------------------------------------------------------
# 7. LLM 大模型配置
# ------------------------------------------------------------
llm:
  provider: "openai"              # LLM提供商
  api_key: "sk-cp-uKdYz_Q3ZY-RXKM2hzGM8j3qwEkDwUk1WsLwfqlrL-mwtdq2xvR09o6_LjA3H1Je0HbDYbqApoyHW8puSiP26DMM3EmyVwzO5knetbzBgfV5WeuAbxypQf8"
                                  # [必须] API密钥
  base_url: 'https://api.minimaxi.com/v1' # API地址，可改为国内代理或其他兼容接口
  model: "MiniMax-M2.7"           # 主模型名称
  timeout: 30                     # API超时时间（秒）
  max_retries: 2                  # 最大重试次数
  retry_delay: 3                  # 重试间隔（秒）
  fallback_model: "MiniMax-M2.5"  # 备选模型（主模型失败时降级使用）
  confidence_threshold: 0.8       # AI置信度阈值（低于此值的刮削结果将被拒绝）
  verify_ssl: false             # 是否验证SSL证书（代理环境可设为false）

# ------------------------------------------------------------
# 8. Hermes 通知配置
# ------------------------------------------------------------
hermes:
  enabled: false                # 是否启用Hermes通知
  webhook:
    base_url: 'http://10.200.200.6:8644' # Hermes服务地址
    route_name: "media-normalize" # Webhook路由名称
    secret: "KsMEsyjo0HOaS6jhjgl9N97RARFvfBx9qRPgcFf21EE" # HMAC签名密钥
    timeout: 30                   # 请求超时（秒）
    max_retries: 3                # 最大重试次数
    retry_delay: 5                # 重试间隔（秒）
    verify_ssl: false           # 是否验证SSL证书（HTTP无需验证，HTTPS建议true）
    events:                       # 启用通知的事件类型
    - batch_start
    - batch_complete
    - program_error
task_queue:
  # 最大并发任务数
  max_concurrent: 1

# ------------------------------------------------------------
# 10. 钩子配置
# ------------------------------------------------------------
hooks:
  allowed_dir: ""                 # 钩子脚本允许目录，为空则仅校验路径安全性
                                  # 设置后钩子脚本必须在此目录下，如: /vol1/scripts/hooks
  before_process: ""              # 处理前执行的脚本路径（必须为绝对路径）
  after_success: ""               # 成功后执行的脚本路径（必须为绝对路径）
  after_failure: ""               # 失败后执行的脚本路径（必须为绝对路径）

# ------------------------------------------------------------
# 11. 日志配置
# ------------------------------------------------------------
logging:
  level: "INFO"                   # 日志级别: DEBUG / INFO / WARNING / ERROR
  format: "json"                  # 日志格式: json / text
  max_size_mb: 100                # 单个日志文件最大大小（MB）
  backup_count: 5                 # 保留的日志文件数量
file_scraping:
  enabled: false
manual_review:
  enabled: false
