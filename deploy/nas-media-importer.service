[Unit]
Description=NAS Media Importer - Auto import video files
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nas-media-importer
ExecStart=/opt/nas-media-importer/venv/bin/python3 media_importer/media_importer.py -c media_importer/config.yaml serve -p 9855 --host 0.0.0.0
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
