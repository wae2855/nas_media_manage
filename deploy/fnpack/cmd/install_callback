#!/bin/bash
# 安装后回调

APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
DEPLOY_DIR="/opt/nas-media-importer"

mkdir -p "${DEPLOY_DIR}/config"
mkdir -p "${DEPLOY_DIR}/data"
mkdir -p "${DEPLOY_DIR}/logs"

if [[ ! -f "${DEPLOY_DIR}/config/config.yaml" ]]; then
    if [[ -f "${DEPLOY_DIR}/config.yaml.example" ]]; then
        cp "${DEPLOY_DIR}/config.yaml.example" "${DEPLOY_DIR}/config/config.yaml"
    fi
fi

if [[ ! -f "${DEPLOY_DIR}/data/tasks.json" ]]; then
    echo '{}' > "${DEPLOY_DIR}/data/tasks.json"
fi
