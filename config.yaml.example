# ============================================================
# NAS影视自动化入库系统 - 配置文件
# ============================================================
# 此文件为配置模板，首次安装时会自动复制到 config/config.yaml
# 升级时 config/config.yaml 不会被覆盖
# 修改后需重启服务才能生效

# ------------------------------------------------------------
# 1. 基础配置
# ------------------------------------------------------------
server:
  host: "0.0.0.0"                # API监听地址，0.0.0.0 监听所有网卡
  port: 9855                     # API监听端口

source_dir: "/vol1/网盘下载"      # [必须] 影视文件来源目录
temp_dir: "/vol1/tmp/media_import" # [必须] 处理过程中的中转目录
log_dir: "/vol1/logs/media_import" # [必须] 日志目录

source_dir_scan:
  recursive: true                # 是否递归扫描子目录
  max_depth: 5                   # 递归最大深度
  ignore_patterns:               # 忽略的文件名模式
    - "*.tmp"
    - ".DS_Store"
    - "*partial*"

video_extensions:                # 支持的视频格式
  - ".mkv"
  - ".mp4"
  - ".avi"
  - ".ts"
  - ".mov"
  - ".wmv"
  - ".m2ts"
  - ".flv"

subtitle_extensions:             # 支持的字幕格式
  - ".srt"
  - ".ass"
  - ".ssa"
  - ".vtt"
  - ".sub"

# ------------------------------------------------------------
# 2. 大模型配置
# ------------------------------------------------------------
llm:
  provider: "openai"             # LLM提供商
  api_key: "your-api-key-here"   # [必须] API密钥
  base_url: "https://api.openai.com/v1" # API地址，可改为国内代理或其他兼容接口
  model: "gpt-4o"                # 主模型名称
  timeout: 30                    # API超时时间（秒）
  max_retries: 2                 # 最大重试次数
  retry_delay: 3                 # 重试间隔（秒）
  fallback_model: "gpt-3.5-turbo" # 备选模型（主模型失败时降级使用）
  confidence_threshold: 0.8      # AI置信度阈值

# ------------------------------------------------------------
# 3. AI判断维度配置
# ------------------------------------------------------------
dimensions:
  - name: media_type
    label: 影视类型
    values:
      - "movie"
      - "tv"
    ai_prompt: "请判断这是电影还是电视剧（movie/tv）"
    ai_hint: "请仅返回movie或tv"

  - name: documentary
    label: 是否纪录片
    values:
      - "yes"
      - "no"
    ai_prompt: "请判断是否为纪录片（yes/no）"

  - name: restricted
    label: 是否限制级
    values:
      - "yes"
      - "no"
    ai_prompt: "请判断是否为限制级内容（yes/no）"

# ------------------------------------------------------------
# 4. 文件名模板配置
# ------------------------------------------------------------
filename_templates:
  movie: "{title_cn}.{title_en}.{year}.{resolution}.{quality}.{ext}"
  tv: "{title_cn}.{title_en}.{year}.S{season:02d}E{episode:02d}.{resolution}.{quality}.{ext}"
  subtitle: "{video_filename}.{lang}.{ext}"

# ------------------------------------------------------------
# 5. 路径规则配置
# [必须] template 中的路径需改为实际入库目录
# 按条件从上到下匹配，第一个匹配的规则生效
# 支持变量: {title_cn} {title_en} {year} {season} {episode} {resolution} {quality} {ext}
# ------------------------------------------------------------
path_rules:
  - conditions:
      media_type: tv
      restricted: "no"
    template: "/vol1/影视/电视剧/{title_cn} ({year})/Season {season}/"

  - conditions:
      media_type: tv
      restricted: "yes"
    template: "/vol1/影视/TV-R/{title_cn} ({year})/Season {season}/"

  - conditions:
      media_type: movie
      documentary: "no"
      restricted: "no"
    template: "/vol1/影视/电影/{year}/{title_cn} ({year})/"

  - conditions:
      media_type: movie
      documentary: "yes"
    template: "/vol1/影视/纪录片/{title_cn} ({year})/"

  - conditions: {}
    template: "/vol1/影视/其他/{title_cn} ({year})/"

# ------------------------------------------------------------
# 6. 特殊处理规则配置
# ------------------------------------------------------------
rules:
  - name: tv_series_folder
    description: "电视剧必须单独文件夹"
    conditions:
      media_type: tv
    actions:
      - create_series_folder: true
      - organize_by_season: true
      - use_series_subfolder: "{title_cn} ({year})/"

  - name: movie_year_folder
    description: "电影按年份分文件夹"
    conditions:
      media_type: movie
    actions:
      - create_year_folder: true

# ------------------------------------------------------------
# 7. 同名文件处理配置
# ------------------------------------------------------------
duplicate_handling:
  strategy: "skip"               # 处理策略: 
                                 #   skip(跳过) - 同名文件已存在则跳过
                                 #   replace(替换) - 用新文件替换已存在的文件
                                 #   rename(重命名) - 两者都保留，新文件添加编号后缀
                                 #   quality(质量优先) - 保留高质量版本：
                                 #     - 有分辨率时按高分辨率优先
                                 #     - 相同分辨率时保留较小文件（压缩更好）
                                 #     - 无分辨率信息时保留体积较大的文件

# ------------------------------------------------------------
# 8. 源文件处理配置
# ------------------------------------------------------------
source_file_handling:
  delete_after_process: true     # 处理成功或跳过后是否删除源文件: true(删除)/false(保留)

# ------------------------------------------------------------
# 9. Hermes配置（飞书通知）
# ------------------------------------------------------------
hermes:
  enabled: true                 # 是否启用Hermes通知
  webhook:
    base_url: "http://your-hermes-ip:8644" # Hermes服务地址
    route_name: "media-normalize" # Webhook路由名称
    secret: ""                    # HMAC签名密钥
    timeout: 30                   # 请求超时（秒）
    max_retries: 3                # 最大重试次数
    retry_delay: 5                # 重试间隔（秒）
    events:                       # 启用通知的事件类型
      - batch_start
      - batch_complete
      - program_error

# ------------------------------------------------------------
# 9. 文件监控配置
# ------------------------------------------------------------
file_watcher:
  enabled: true                  # 是否启用文件监控
  poll_interval: 10              # 轮询间隔（秒）
  ignore_patterns:               # 监控忽略的文件名模式
    - "*.tmp"
    - ".DS_Store"
    - "*partial*"

# ------------------------------------------------------------
# 10. 任务队列配置
# ------------------------------------------------------------
task_queue:
  persistence_path: "tasks.json" # 任务持久化文件路径
  max_concurrent: 1              # 最大并发任务数

# ------------------------------------------------------------
# 11. 钩子配置
# ------------------------------------------------------------
hooks:
  before_process: ""             # 处理前执行的命令
  after_success: ""              # 成功后执行的命令
  after_failure: ""              # 失败后执行的命令

# ------------------------------------------------------------
# 12. 日志配置
# ------------------------------------------------------------
logging:
  level: "INFO"                  # 日志级别: DEBUG / INFO / WARNING / ERROR
  format: "json"                 # 日志格式: json / text
  max_size_mb: 100               # 单个日志文件最大大小（MB）
  backup_count: 5                # 保留的日志文件数量
