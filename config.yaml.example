# ============================================================
# 影音库AI智能整理 - 配置模板
# ============================================================
# 首次安装时会自动复制到 config/config.yaml
# 升级时 config/config.yaml 不会被覆盖
# 修改后需重启服务才能生效

# ------------------------------------------------------------
# 1. 轮询监控配置
# ------------------------------------------------------------
file_watcher:
  enabled: true                   # 是否启用文件监控（轮询扫描源目录）
  poll_interval: 60               # 轮询间隔（秒），建议不低于30秒
  ignore_patterns:                # 监控忽略的文件名模式
    - "*.tmp"
    - ".DS_Store"
    - "*partial*"

# ------------------------------------------------------------
# 2. API安全与基础配置
# ------------------------------------------------------------
server:
  host: "0.0.0.0"                 # API监听地址，0.0.0.0 监听所有网卡
  port: 9855                      # API监听端口
                                  # ⚠️ 修改端口后需: 1.重启服务 2.同步修改Hermes路由配置
                                  #   3.防火墙放行新端口 4.浏览器地址同步修改
  api_key: ""                     # API认证密钥，为空则不启用认证
                                  # 设置后所有 /api/ 端点需携带 Authorization: Bearer <api_key>
                                  # 建议使用随机字符串，如: openssl rand -hex 32

# [必须] 影视文件来源目录
# 注意：如果源目录是飞牛挂载的网盘目录，文件刷新时间可能较久，建议改用Alist网盘来实现短时刷新
source_dir: "/vol1/网盘下载"
# [必须] 处理过程中的中转目录
temp_dir: "/vol1/tmp/media_import"
# [必须] 日志目录
log_dir: "/vol1/logs/media_import"

source_policy:
  recycle_dir: "/vol1/@appdata/nas-media-importer/data/recycle"
                                  # 回收站路径，重复文件和失败超限文件将被移入此目录
                                  # ⚠️ 不能与源目录或中转目录相同
  max_auto_retries: 3             # 同一文件失败超过此次数后移入回收站
  scan_recursive: true            # 是否递归扫描源目录子目录
  scan_max_depth: 5               # 源目录递归扫描最大深度

video_extensions:                 # 支持的视频格式（仅这些后缀的文件会被处理）
  - ".mkv"
  - ".mp4"
  - ".avi"
  - ".ts"
  - ".mov"
  - ".wmv"
  - ".m2ts"
  - ".flv"

subtitle_extensions:              # 支持的字幕格式
  - ".srt"
  - ".ass"
  - ".ssa"
  - ".vtt"
  - ".sub"

# ------------------------------------------------------------
# 3. 入库规则配置
# ------------------------------------------------------------
# 维度配置已移至数据库管理，请通过 Web UI 的「维度配置」页签进行管理
# 默认启用3个维度：影视类型(media_type)、是否纪录片(documentary)、限制级分类(restricted_level)
# 可添加维度：是否动漫(animation)、地区(region)、原始语言(origin_lang)、分辨率等级(resolution_tier)、类型(broad_genre)

# 路径规则：按条件从上到下匹配，第一个匹配的规则生效
# 支持变量: {title_cn} {title_en} {year} {season} {episode} {resolution} {quality} {ext}
# ⚠️ 重要说明：规则从上到下匹配，命中即停止。请将精确规则放前面，通用规则放后面。
# ⚠️ restricted_level 支持多选，多个值用 | 分隔（如：0-6|7-12|13-15）
path_rules:
  - conditions:
      media_type: tv
      animation: "true"
      restricted_level: "0-6|7-12"
    template: "/vol1/影视/动漫/家庭向/{title_cn} ({year})/Season {season}/"

  - conditions:
      media_type: tv
      animation: "true"
      restricted_level: "13-15|17+"
    template: "/vol1/影视/动漫/青少年向/{title_cn} ({year})/Season {season}/"

  - conditions:
      media_type: tv
      animation: "true"
    template: "/vol1/影视/动漫/{title_cn} ({year})/Season {season}/"

  - conditions:
      media_type: movie
      animation: "true"
    template: "/vol1/影视/动漫电影/{title_cn} ({year})/"

  - conditions:
      media_type: tv
      restricted_level: "17+"
    template: "/vol1/影视/TV-R/{title_cn} ({year})/Season {season}/"

  - conditions:
      media_type: tv
    template: "/vol1/影视/电视剧/{title_cn} ({year})/Season {season}/"

  - conditions:
      media_type: movie
      documentary: "true"
    template: "/vol1/影视/纪录片/{title_cn} ({year})/"

  - conditions:
      media_type: movie
      restricted_level: "17+"
    template: "/vol1/影视/电影-R/{year}/{title_cn} ({year})/"

  - conditions:
      media_type: movie
    template: "/vol1/影视/电影/{year}/{title_cn} ({year})/"

  - conditions: {}
    template: "/vol1/影视/其他/{title_cn} ({year})/"

# 兜底入库目录：所有规则都不匹配时，文件将存入此目录
# 不设置时，无匹配的文件在分类阶段报错中断
fallback_dir: "/vol1/影视/未分类/"

# 特殊处理规则
rules:
  - name: tv_series_folder
    description: "电视剧必须单独文件夹"
    conditions:
      media_type: tv
    actions:
      - create_series_folder: true
      - organize_by_season: true
      - use_series_subfolder: "{title_cn} ({year})/"

  - name: movie_year_folder
    description: "电影按年份分文件夹"
    conditions:
      media_type: movie
    actions:
      - create_year_folder: true

# ------------------------------------------------------------
# 4. 文件名模板配置
# ------------------------------------------------------------
# 支持变量: {title_cn} {title_en} {year} {season} {episode} {resolution} {quality} {lang} {ext} {video_filename}
filename_templates:
  movie: "{title_cn}.{title_en}.{year}.{resolution}.{quality}.{ext}"
  tv: "{title_cn}.{title_en}.{year}.S{season:02d}E{episode:02d}.{resolution}.{quality}.{ext}"
  subtitle: "{video_filename}.{lang}.{ext}"

# ------------------------------------------------------------
# 5. 同名文件处理配置
# ------------------------------------------------------------
duplicate_handling:
  enabled: true                   # 是否启用智能同名检测（推荐启用）
                                  #   true  - 扫描所有入库目录，按下方 strategy 处理
                                  #   false - 跳过智能检测，仅在文件移动到目标目录时检测同名
                                  #           若目标目录已存在同名文件，入库失败
  strategy: "quality"             # 处理策略（仅 enabled=true 时生效）:
                                  #   skip(跳过) - 同名文件已存在则跳过
                                  #   replace(替换) - 用新文件替换已存在的文件
                                  #   rename(重命名) - 两者都保留，新文件添加编号后缀
                                  #   quality(质量优先) - 保留高质量版本：
                                  #     - 有分辨率时按高分辨率优先
                                  #     - 相同分辨率时保留较小文件（压缩更好）
                                  #     - 无分辨率信息时保留体积较大的文件

# ------------------------------------------------------------
# 6. 源文件处理策略
# ------------------------------------------------------------
# 源目录中的文件在处理完成后会被自动清理（包括视频和附属字幕文件），以保持源目录干净：
#   处理成功 → 源文件立即删除
#   处理跳过 → 源文件立即删除
#   处理失败（未超限）→ 源文件保留，等待下次重试
#   处理失败（超限）→ 源文件移入回收站
# 重复文件处理策略详见 source_policy 配置

# ------------------------------------------------------------
# 6.5 入库前人工检查配置
# ------------------------------------------------------------
manual_review:
  enabled: false                  # 是否启用入库前人工检查
                                  #   启用后，视频刮削分类完成时不会自动入库
                                  #   而是进入"确认中"(CONFIRMING)状态等待人工确认
                                  #   确认后执行入库，有问题可回退到源目录

# ------------------------------------------------------------
# 6.8 影视元数据刮削配置
# ------------------------------------------------------------
metadata:
  tmdb:
    enabled: false                  # 是否启用TMDb（The Movie Database）元数据API
                                  #   true  - 优先使用TMDb，失败时降级到LLM
                                  #   false - 完全使用LLM进行刮削
    api_key: ""                   # [必须] TMDb API密钥（如果 enabled=true 时必填
                                  # 获取地址：https://www.themoviedb.org/settings/api
                                  # 注册账号后，申请开发者API Key即可
    language: "zh-CN"           # TMDb返回语言（默认中文）
    fallback_language: "en-US"   # 中文无结果时的回退语言
    request_timeout: 10           # API请求超时（秒）
    max_retries: 3                # API失败重试次数

# ------------------------------------------------------------
# 7. LLM 大模型配置
# ------------------------------------------------------------
llm:
  provider: "openai"              # LLM提供商
  api_key: ""                     # [必须] API密钥
  base_url: "https://api.openai.com/v1" # API地址，可改为国内代理或其他兼容接口
  model: "gpt-3.5-turbo"         # 主模型名称
  timeout: 30                     # API超时时间（秒）
  max_retries: 2                  # 最大重试次数
  retry_delay: 3                  # 重试间隔（秒）
  fallback_model: "gpt-3.5-turbo" # 备选模型（主模型失败时降级使用）
  fast_model: ""                  # 快速模型（标题清洗+TMDB结果整理，留空则使用fallback_model）
  fast_base_url: ""               # 快速模型API地址（留空则使用base_url）
  fast_api_key: ""                # 快速模型API密钥（留空则使用api_key）
  confidence_threshold: 0.8       # AI置信度阈值（低于此值的刮削结果将被拒绝）
  verify_ssl: true                # 是否验证SSL证书（代理环境可设为false）
                                  # 如需自定义刮削提示词，请在 config/scraper_prompts.md 中配置

# ------------------------------------------------------------
# 7.1 刮削提示词配置
# ------------------------------------------------------------
# 提示词配置已移至单独文件: config/scraper_prompts.md
# 该文件包含:
#   - system_prompt: 单个视频刮削提示词
#   - series_prompt: 电视剧系列刮削提示词
# 如需自定义刮削行为，请编辑 config/scraper_prompts.md 文件

# ------------------------------------------------------------
# 8. Hermes 通知配置
# ------------------------------------------------------------
hermes:
  enabled: true                   # 是否启用Hermes通知
  webhook:
    base_url: "http://your-hermes-ip:8644" # Hermes服务地址
    route_name: "media-normalize" # Webhook路由名称
    secret: ""                    # HMAC签名密钥
    timeout: 30                   # 请求超时（秒）
    max_retries: 3                # 最大重试次数
    retry_delay: 5                # 重试间隔（秒）
    verify_ssl: true              # 是否验证SSL证书（HTTP无需验证，HTTPS建议true）
    events:                       # 启用通知的事件类型
      - batch_start               #   批量处理开始
      - batch_complete            #   批量处理完成
      - program_error             #   程序异常

# ------------------------------------------------------------
# 9. 任务队列配置
# ------------------------------------------------------------
task_queue:
  max_concurrent: 1               # 最大并发任务数

# ------------------------------------------------------------
# 10. 钩子配置
# ------------------------------------------------------------
hooks:
  allowed_dir: ""                 # 钩子脚本允许目录，为空则仅校验路径安全性
                                  # 设置后钩子脚本必须在此目录下，如: /vol1/scripts/hooks
  before_process: ""              # 处理前执行的脚本路径（必须为绝对路径）
  after_success: ""               # 成功后执行的脚本路径（必须为绝对路径）
  after_failure: ""               # 失败后执行的脚本路径（必须为绝对路径）

# ------------------------------------------------------------
# 11. 日志配置
# ------------------------------------------------------------
logging:
  level: "INFO"                   # 日志级别: DEBUG / INFO / WARNING / ERROR
  format: "json"                  # 日志格式: json / text
  max_size_mb: 100                # 单个日志文件最大大小（MB）
  backup_count: 5                 # 保留的日志文件数量
